// examples/k-nucleotide.nika
//
// The Computer Language Benchmarks Game's `k-nucleotide`: read a DNA sequence
// in FASTA form from **standard input**, and report how often each short
// fragment occurs in it.
//
// Run:
//
//     nikaia --input examples/k-nucleotide.nika --backend rust
//     ./k-nucleotide < dna.fasta
//
// `crates/nikaia/tests/examples.rs` compiles and runs this file, on the file
// itself rather than a copy of it, with the input arriving on a **pipe**.
//
// Why it is here beside the others. It is the first program that reads standard
// input ([ADR-019](../docs/specification/adr/adr-019.md)), and the difference
// that makes is worth seeing rather than being told:
//
//   * **A stream is not a file.** `1brc.nika` maps its input and every station
//     name is a view into the pages - nothing is copied at all. Here there are
//     no pages: the bytes do not exist until they are read, so the program owns
//     its buffer. Everything *after* that first copy is the same, and this file
//     is where that shows - the fragments counted below are views into the
//     sequence, thousands of them, and none of them is a string.
//   * **Looks blocking, is not.** There is no `async` on `main` and no `await`
//     on the read. Under Lite the event loop runs another task while the pipe
//     is empty; under Advanced the read may resume on a different thread. The
//     source says neither, and the two profiles must print the same thing -
//     which the test checks.
//   * **A grammar for a format that is nearly not one.** FASTA is a header line
//     beginning with `>` and the lines under it. That is small enough that the
//     usual answer is a pair of loops with an index; it is written as a grammar
//     here because the result is a *tree* of sections, and because `until` and
//     `not(">")` say what a hand-rolled scan would have to be read to discover.

use std::io
use std::cli

// ---------------------------------------------------------------------------
// 1. FASTA
// ---------------------------------------------------------------------------

grammar Fasta {

    // A file where every character counts: a blank is not a separator, and a
    // newline is the structure. Defining `WS` as empty is what says so - the
    // skip the backend puts between the elements of a syntactic rule would
    // otherwise eat the very line endings this grammar is made of.
    rule WS = "" -> { }

    pub rule file -> Vec[Section] =
        sections:section* -> { sections }

    // A header, then every line that does not start a new one. `not(">")`
    // consumes nothing: it is the test that ends the body, and writing it here
    // means the repetition needs no terminator of its own.
    rule section -> Section =
        ">" header:LINE body:body_line* -> { Section { header, lines: body } }

    rule body_line -> &str = not(">") l:LINE -> { l }

    // `until` stops before the terminator, so the line ending is consumed
    // explicitly. A file that does not end in one is not FASTA, and saying so
    // here is better than accepting it and losing the last line silently.
    rule LINE -> &str = s:until(line_ending) line_ending -> { s }
}

@borrowed
pub struct Section {
    header: &str,
    lines: Vec[&str],
}

// ---------------------------------------------------------------------------
// 2. Counting
// ---------------------------------------------------------------------------

// A count is a struct with a method rather than a number, for the reason
// `access-log.nika`'s `Counts` is: `entry(..).and_modify` hands the lambda the
// value that is already there, and what to do to it is a method on it.
pub struct Tally {
    n: i64,
}

impl Tally {
    pub fn(first: i64) -> Tally sync {
        return Tally(n: first)
    }

    fn bump(&mut self) sync {
        self.n += 1
    }
}

// Every fragment of length `k`, and how often each occurs.
//
// The keys are **views into `seq`** - `seq[i..i + k]` is a slice, not a copy -
// so a sequence of a million characters counted at k = 12 builds a table of
// pointers and lengths rather than a million small strings. That is the same
// claim `1brc.nika` makes about station names (Part II, 10.6), on a buffer the
// program owns rather than one it mapped.
fn count(seq: &str, k: usize) -> HashMap[&str, Tally] {
    let mut counts: HashMap[&str, Tally] = HashMap::new()

    if seq.len() < k {
        return counts
    }

    for i in 0..seq.len() - k + 1 {
        let fragment = &seq[i..i + k]
        counts
            .entry(fragment)
            .and_modify fn { a.bump() }
            .or_insert_with fn { Tally(1) }
    }

    return counts
}

// The fragments of one length, as percentages, most frequent first.
//
// Two stable sorts state the compound order the benchmark asks for, which is
// what Part I 4.5 says they are for: by fragment ascending, then by count
// descending, and the second keeps the order of the first among equals.
fn report_frequencies(seq: &str, k: usize) {
    let counts = count(seq, k)

    let mut rows = Vec::new()
    let mut total = 0
    for (fragment, tally) in counts {
        total += tally.n
        rows.push((fragment, tally.n))
    }

    rows.sort_by_key fn { a.0 }
    rows.sort_by_key fn { -a.1 }

    for row in rows {
        let percent = (row.1 as f64) * 100.0 / (total as f64)
        println(f"{row.0} {percent:.3}")
    }
    println("")
}

// One named fragment, and how often it occurs. `k` is the fragment's own
// length, so the table is built for exactly the width being asked about.
fn report_fragment(seq: &str, fragment: &str) {
    let counts = count(seq, fragment.len())
    // A trailing lambda goes outside the parentheses and is the last
    // argument; a lambda in any other position is written out.
    let n = counts.get(fragment).map_or(0, fn(t) { t.n })
    println(f"{n}\t{fragment}")
}

// ---------------------------------------------------------------------------
// 3. The program
// ---------------------------------------------------------------------------

fn main() throws {
    // The whole of standard input, owned. There is no `map` for a pipe and no
    // `await` on the read: ADR-019 D1 and D2, in one line.
    let text = io::read_to_string() catch {
        eprintln(f"cannot read standard input: {error}")
        return
    }

    let sections = dsl Fasta from text catch {
        eprintln(f"standard input is not FASTA: {error}")
        return
    }

    // The benchmark reports on the third section. Which one that is by name is
    // the caller's business, so it is an argument with the benchmark's own
    // answer as the default.
    let wanted = cli::args().nth(1) ?? "THREE"

    let mut seq = String::new()
    for section in sections {
        if section.header.starts_with(wanted.as_str()) {
            for line in section.lines {
                seq.push_str(&line.to_uppercase())
            }
        }
    }

    if seq.len() == 0 {
        eprintln(f"no section whose header starts with {wanted}")
        return
    }

    report_frequencies(&seq, 1)
    report_frequencies(&seq, 2)

    report_fragment(&seq, "GGT")
    report_fragment(&seq, "GGTA")
    report_fragment(&seq, "GGTATT")
    report_fragment(&seq, "GGTATTTTAATT")
    report_fragment(&seq, "GGTATTTTAATTTATAGT")
}
