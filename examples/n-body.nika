// examples/n-body.nika
//
// The Computer Language Benchmarks Game's `n-body`: five bodies of the solar
// system, integrated forward by a symplectic step, with the total energy
// printed before and after.
//
// Run:
//
//     nikaia --input examples/n-body.nika --backend rust
//     ./n-body 1000
//     -0.169075164
//     -0.169087605
//
// `crates/nikaia/tests/examples.rs` compiles and runs this file, on the file
// itself rather than a copy of it.
//
// Why it is here beside the others. Every other example in this directory
// parses something: the `grammar` construct is what 0.0.7 is about, and four
// programs in a row that all start with a DSL would say that Nikaia is a
// parser generator. This one has no grammar, no input format and no I/O. It is
// arithmetic in a loop, which is the other half of what a systems language is
// judged on - and the one benchmark here whose numbers are directly comparable
// against Rust, C and Go, because the CLBG publishes the same program in some
// thirty languages with an exact expected output.
//
// What it shows:
//
//   * **`sync` as a property the compiler checks** (Part II, 12.1). Every
//     method here is pure computation that cannot pause and cannot do I/O.
//     Saying so is what would let the whole integration run inside a
//     `par_iter` without anyone having to remember that it is safe.
//   * **Data and behaviour, kept apart** (Part I, 4.3). `Body` is six numbers
//     and a mass; `System` is the list and what may be done to it. There is no
//     class, and `&mut self` is where a mutation is written down.
//   * **Arithmetic that reads like arithmetic.** `0..n`, `1e-3`, and
//     `(dx * dx + dy * dy + dz * dz).sqrt()` - three things the language could
//     not say before this file was written, listed under G14 in the README.

use std::cli

// One body: a position, a velocity, and a mass. All `f64`, and all of it
// mutated in place - the benchmark's whole point is that the loop below runs
// millions of times, so a step that rebuilt the list would be measuring the
// allocator.
pub struct Body {
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vy: f64,
    vz: f64,
    mass: f64,
}

// The list, and what may be done to it. `System` rather than a bare
// `Vec[Body]` because the interesting operations are about the *set* of bodies
// - the pairwise force, the total energy - and a method on the set is where
// those belong (Part I, 4.3).
pub struct System {
    bodies: Vec[Body],
}

impl System {

    // The sun's velocity is not given: it is whatever makes the total momentum
    // of the system zero, which is what keeps the centre of mass still and the
    // energy comparable between runs. The benchmark specifies this, and it is
    // the one place where a body is defined by all the others.
    fn offset_momentum(&mut self) sync {
        let mut px = 0.0
        let mut py = 0.0
        let mut pz = 0.0

        for i in 0..self.bodies.len() {
            px = px + self.bodies[i].vx * self.bodies[i].mass
            py = py + self.bodies[i].vy * self.bodies[i].mass
            pz = pz + self.bodies[i].vz * self.bodies[i].mass
        }

        let solar_mass = 4.0 * 3.141592653589793 * 3.141592653589793
        self.bodies[0].vx = -px / solar_mass
        self.bodies[0].vy = -py / solar_mass
        self.bodies[0].vz = -pz / solar_mass
    }

    // One symplectic step: every pair pulls on both of its bodies, then every
    // body moves. Splitting it that way is what makes the integrator
    // *symplectic* - the energy stays bounded over millions of steps instead of
    // drifting - and it is why the two loops cannot be merged into one.
    //
    // The inner loop starts at `i + 1`: a pair is counted once and its two
    // halves differ only in sign, which halves the work and is the reason the
    // benchmark is written with indices rather than with a pair of `for`s over
    // the list.
    fn advance(&mut self, dt: f64) sync {
        let n = self.bodies.len()

        for i in 0..n {
            for j in i + 1..n {
                let dx = self.bodies[i].x - self.bodies[j].x
                let dy = self.bodies[i].y - self.bodies[j].y
                let dz = self.bodies[i].z - self.bodies[j].z

                let d2 = dx * dx + dy * dy + dz * dz
                let mag = dt / (d2 * d2.sqrt())

                let mi = self.bodies[i].mass
                let mj = self.bodies[j].mass

                self.bodies[i].vx = self.bodies[i].vx - dx * mj * mag
                self.bodies[i].vy = self.bodies[i].vy - dy * mj * mag
                self.bodies[i].vz = self.bodies[i].vz - dz * mj * mag

                self.bodies[j].vx = self.bodies[j].vx + dx * mi * mag
                self.bodies[j].vy = self.bodies[j].vy + dy * mi * mag
                self.bodies[j].vz = self.bodies[j].vz + dz * mi * mag
            }
        }

        for i in 0..n {
            self.bodies[i].x = self.bodies[i].x + dt * self.bodies[i].vx
            self.bodies[i].y = self.bodies[i].y + dt * self.bodies[i].vy
            self.bodies[i].z = self.bodies[i].z + dt * self.bodies[i].vz
        }
    }

    // Kinetic energy of each body, less the potential energy of each pair.
    // This is the number the benchmark checks: it is conserved by an exact
    // integrator, so printing it before and after says whether the arithmetic
    // held up.
    fn energy(&self) -> f64 sync {
        let n = self.bodies.len()
        let mut e = 0.0

        for i in 0..n {
            let b = &self.bodies[i]
            e = e + 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)

            for j in i + 1..n {
                let dx = b.x - self.bodies[j].x
                let dy = b.y - self.bodies[j].y
                let dz = b.z - self.bodies[j].z
                e = e - (b.mass * self.bodies[j].mass) / (dx * dx + dy * dy + dz * dz).sqrt()
            }
        }

        return e
    }
}

// The five bodies, in the units the benchmark fixes: astronomical units, days,
// and a solar mass of 4 pi squared. The velocities are per day and are scaled
// by the days in a year, which is why every one of them carries the factor.
//
// The exponents are what makes this readable: `9.54791938424326609e-04` is
// Jupiter's mass beside the sun's `1.0`, and the same number written out as
// zeroes is how a digit gets lost in a diff.
fn solar_system() -> System {
    let days_per_year = 365.24
    let solar_mass = 4.0 * 3.141592653589793 * 3.141592653589793

    let mut bodies = Vec::new()

    bodies.push(Body {
        x: 0.0, y: 0.0, z: 0.0,
        vx: 0.0, vy: 0.0, vz: 0.0,
        mass: solar_mass,
    })

    bodies.push(Body {
        x: 4.84143144246472090e+00,
        y: -1.16032004402742839e+00,
        z: -1.03622044471123109e-01,
        vx: 1.66007664274403694e-03 * days_per_year,
        vy: 7.69901118419740425e-03 * days_per_year,
        vz: -6.90460016972063023e-05 * days_per_year,
        mass: 9.54791938424326609e-04 * solar_mass,
    })

    bodies.push(Body {
        x: 8.34336671824457987e+00,
        y: 4.12479856412430479e+00,
        z: -4.03523417114321381e-01,
        vx: -2.76742510726862411e-03 * days_per_year,
        vy: 4.99852801234917238e-03 * days_per_year,
        vz: 2.30417297573763929e-05 * days_per_year,
        mass: 2.85885980666130812e-04 * solar_mass,
    })

    bodies.push(Body {
        x: 1.28943695621391310e+01,
        y: -1.51111514016986312e+01,
        z: -2.23307578892655734e-01,
        vx: 2.96460137564761618e-03 * days_per_year,
        vy: 2.37847173959480950e-03 * days_per_year,
        vz: -2.96589568540237556e-05 * days_per_year,
        mass: 4.36624404335156298e-05 * solar_mass,
    })

    bodies.push(Body {
        x: 1.53796971148509165e+01,
        y: -2.59193146099879641e+01,
        z: 1.79258772950371181e-01,
        vx: 2.68067772490389322e-03 * days_per_year,
        vy: 1.62824170038242295e-03 * days_per_year,
        vz: -9.51592254519715870e-05 * days_per_year,
        mass: 5.15138902046611451e-05 * solar_mass,
    })

    return System { bodies: bodies }
}

fn main() {
    // The number of steps, as the benchmark takes it. The default is what the
    // test in `crates/nikaia/tests/examples.rs` runs, so the two numbers below
    // are checked rather than described.
    // `??` is for a value that may be absent (Part I, 3.5) - `nth` returns
    // one. Parsing it is a different thing: it *fails*, so its answer is a
    // `catch` (7.1) and the fallback is the handler's value.
    let steps = cli::args().nth(1) ?? "1000"
    let n: i32 = steps.parse() catch { 1000 }

    let mut system = solar_system()
    system.offset_momentum()

    println("{system.energy():.9}")
    for _step in 0..n {
        system.advance(0.01)
    }
    println("{system.energy():.9}")
}
