// examples/config.nika
//
// An INI-style configuration file, parsed and printed back.
//
// Input:  sections and settings, with `#` comments anywhere
// Output: the sections and what is in each, in the order they were written
//
// Run:
//
//     nikaia --input examples/config.nika --backend rust
//     ./config app.conf
//
// `crates/nikaia/tests/examples.rs` compiles and runs this file, on the file
// itself rather than a copy of it.
//
// Why it is here beside the others. 1BRC and `access-log.nika` are both one
// record repeated to the end of the file; `calc.nika` is one expression. A
// configuration file is neither: it has *structure*, sections holding
// settings, and the shape of the result is a tree rather than a number or a
// tally. Three things follow that none of the others shows.
//
//   * **A grammar that defines its own whitespace.** `WS` below is the rule
//     the backend inserts between the elements of every syntactic rule, and
//     redefining it to include `COMMENT` is what makes `#` legal everywhere a
//     blank is - without one other rule in this file mentioning comments.
//   * **A repetition that keeps what it matched.** `setting*` collects, which
//     is right here and wrong at a billion rows; that is the same choice
//     `1brc.nika` makes in the other direction with `par_fold`, and seeing
//     both is the point.
//   * **Nesting.** `Section` holds a `Vec[Setting]` whose `&str`s are slices
//     of the input, so the whole tree is views into one buffer and the
//     compiler ties `Section` to it through the `Vec` (Part II, 10.6).

use std::fs
use std::cli

grammar Config {

    // Defining `WS` replaces the implicit skip. A rule that is *not* here
    // would have to say where a comment may appear, once per position; this
    // says it once, and every syntactic rule below inherits it.
    //
    // It is also the exact shape that used to make every error message in a
    // grammar useless: two alternatives at the same position, so the real
    // expectation lost the comparison and was discarded. Fixed upstream, and
    // this file is where a Nikaia program would have met it.
    rule WSE = multispace1 -> { }
    rule WS = (WSE | COMMENT)* -> { }
    rule COMMENT = "#" until(line_ending) -> { }

    // A header and everything under it. The repetition stops on its own at
    // the next `[`, because a setting has to start with a name and `[` is not
    // one - no lookahead, no terminator, nothing to state.
    rule section -> Section =
        "[" name:NAME "]" settings:setting* -> { Section { name, settings } }

    rule setting -> Setting =
        key:NAME "=" value:VALUE -> { Setting { key, value } }

    rule NAME -> &str = s:raw_ident -> { s }

    // Lexical: a value may contain blanks, dots and colons, so the only things
    // that end it are the end of the line and a comment. Naming both in the
    // terminator is what makes `port = 8080  # the usual one` a port rather
    // than a port and an opinion - and the trailing blanks it leaves are the
    // action's business, which is what an action is for.
    //
    // The price, stated rather than hidden: a `#` inside a value is a comment
    // here. A format that needs one needs quoting, and quoting is a rule.
    rule VALUE -> &str = s:until("#" | line_ending) -> { s.trim() }

    pub rule file -> Vec[Section] =
        sections:section* -> { sections }
}

@borrowed
pub struct Setting {
    key: &str,
    value: &str,
}

// `Section` never says `&`, and is tied to the input all the same: it holds a
// `Vec[Setting]`, and a `Setting` holds views. That is the transitive half of
// Part II, 10.6, and it is inferred rather than declared.
@borrowed
pub struct Section {
    name: &str,
    settings: Vec[Setting],
}

fn main() throws {
    let path = cli::args().nth(1) ?? "app.conf"

    // `read_to_string` rather than `map`: a configuration file is small, and
    // the text has to outlive nothing here. `fs::map` is the other half of the
    // same module and what 1BRC needs (Part III, 17.1).
    let text = fs::read_to_string(&path) catch {
        eprintln("cannot read {path}: {error}")
        return
    }

    let sections = dsl Config from text catch {
        eprintln("{path}: {error}")
        return
    }

    println("{sections.len()} sections")

    for section in sections {
        println("[{section.name}]")
        for setting in section.settings {
            println("  {setting.key} = {setting.value}")
        }
    }
}
