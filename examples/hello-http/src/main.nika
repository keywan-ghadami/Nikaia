// **A server**, and the program on the other end of
// [ADR-069](../../../docs/specification/adr/adr-069.md) D1's path arm.
//
// What it exercises is the pair: `http/` is a package reached **by a path**, and
// this is a program that reaches it. Until this directory existed nothing in the
// corpus wrote that arm with a Nikaia package on the end of it (the `type =
// "rust"` arm has `examples/foreign-runtime/`).
//
// It used to render a response and print it, because there was no server to hand
// one to. There is now
// ([ADR-194](../../../docs/specification/adr/adr-194.md) D5), so this asks for
// one — which is the whole of what a program has to write: an address, and one
// function that decides.
use http
use std::cli

fn main() throws {
    // Port `0` is *any free one*, which is what a test wants; `listen` prints
    // the address it got, which is how the test finds out which.
    let at = cli::args().nth(1) ?? "127.0.0.1:8080".to_string()

    // **One function and not a route table**, which is the package's own note:
    // `NK1142` refuses a function type in a field, so nothing can keep a
    // handler per path. What a program writes instead is the decision itself,
    // which is also ADR-194 D4's rule — the program says what is exposed.
    http::listen(at) fn(request) {
        if request.method() == http::Method::Post {
            let size = request.body().len()
            return http::Response::text(f"you sent {size} bytes")
        }
        // **The query string is its own question**
        // ([ADR-018](../../../docs/specification/adr/adr-018.md) D4), and
        // **nothing** is not an empty string: `?name=` and no `name` at all are
        // two different facts, and `??` is where a program says what it does
        // about the second.
        if request.path() == "/" {
            let who = request.query("name") ?? "world"
            return http::Response::text(f"Hello, {who}")
        }
        // And a header, case-insensitive as the protocol is.
        if request.path() == "/who" {
            let host = request.header("host") ?? "nobody"
            return http::Response::text(f"you asked {host}")
        }
        return http::Response::not_found()
    }
}
