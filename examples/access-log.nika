// examples/access-log.nika
//
// A web server's access log, summarised.
//
// Input:  one request per line, "<ip> <method> <path> <status> <bytes>", e.g.
//         "203.0.113.7 GET /index.html 200 5120"
// Output: the request count, how many of them failed, and one line per path
//         with its hits and the bytes it sent, sorted by path.
//
// Run:
//
//     nikaia --input examples/access-log.nika --backend rust
//     ./access-log access.log
//
// `crates/nikaia/tests/examples.rs` compiles and runs this file, on the file
// itself rather than a copy of it.
//
// Why it is here beside 1brc and calc. 1brc is one field and a number, at a
// size where only throughput matters; calc is a grammar with no I/O at all.
// This is the shape most real work has: a line with *several* fields of
// different kinds, a record built from them, and a report at the end. Three
// things it shows that neither of the others does.
//
//   * **A frame with more than one scan in it.** `until(" " | frame_end)`
//     appears four times, and each one has to name the frame's boundary as an
//     alternative or the compiler rejects it (ADR-009 D1). That is not
//     ceremony: a scan that does not stop at the newline would run a truncated
//     line into the next one and silently invent a request that was never
//     made.
//   * **A field the format fixes the width of.** A status is `digit{3}`, so
//     "20" is a parse error at the third character rather than the number 20
//     followed by whatever the parser makes of the rest.
//   * **What a rejected line looks like.** The parse is one expression, so the
//     failure is one value: `catch` below prints where in the file the line is
//     and what was expected there, and the program exits without a summary
//     rather than with a wrong one.

use std::fs
use std::cli
use std::collections::HashMap

grammar Log {

    // Up to the next blank, or to the end of the line - whichever comes first.
    // The second alternative is what makes this safe inside a frame: a line
    // missing its last field stops at the newline instead of eating the line
    // after it.
    rule FIELD -> &str = s:until(" " | frame_end) -> { s }

    // Three digits, exactly. The format says a status is three digits, so the
    // grammar says it too - and a line carrying "20" fails here, where the
    // reader can see why, instead of somewhere downstream.
    rule STATUS -> i32 = n:dec[i32](digit{3}) -> { n }

    rule SIZE -> i64 = n:dec[i64](digit+) -> { n }

    // A request can be found from any offset by scanning to the next newline,
    // which is what `@frame` says and what makes the parse parallel. Lexical
    // (uppercase), because the implicit whitespace of a syntactic rule would
    // eat the newline the file is cut at - and here the blanks between fields
    // are part of the format, not decoration.
    @frame(boundary: "\n")
    rule ENTRY -> Hit =
        _ip:FIELD " " => method:FIELD " " path:FIELD " " status:STATUS " " bytes:SIZE frame_end
        -> { Hit { path, status, bytes } }

    // The entry rule is the file. A fold rather than `ENTRY*`: a log is
    // append-only and unbounded, and a report is small, so nothing is
    // collected. `par_fold` adds how two partial reports combine, which is all
    // the compiler needs to cut the file and parse the pieces on every core.
    pub rule file -> Report =
        par_fold(ENTRY, Report::new, fn(acc, e) { acc.record(e) }, Report::merge)
}

// The `_ip` is parsed and dropped: the grammar has to consume it, the report
// does not need it. Marked `@borrowed` because `path` is a slice of the mapped
// file and never a copy - at a million lines that is the difference between a
// report and a second copy of the log.
@borrowed
pub struct Hit {
    path: &str,
    status: i32,
    bytes: i64,
}

pub struct Counts {
    hits: i64,
    bytes: i64,
}

impl Counts {
    pub fn(bytes: i64) -> Counts {
        return Counts(hits: 1, bytes: bytes)
    }

    fn add(&mut self, bytes: i64) sync {
        self.hits += 1
        self.bytes += bytes
    }

    fn merge(&mut self, other: &Counts) sync {
        self.hits += other.hits
        self.bytes += other.bytes
    }
}

pub struct Report {
    paths: HashMap[&str, Counts],
    requests: i64,
    failures: i64,
}

impl Report {
    pub fn() -> Report {
        return Report(paths: HashMap::new(), requests: 0, failures: 0)
    }

    // `sync`: pure computation, no I/O, cannot pause - which is what lets the
    // fold run on every core. The compiler checks it here rather than trusting
    // the author to remember it at the call site.
    fn record(&mut self, e: Hit) sync {
        self.requests += 1
        if e.status >= 400 { self.failures += 1 }
        self.paths
            .entry(e.path)
            .and_modify fn { a.add(e.bytes) }
            .or_insert_with fn { Counts(e.bytes) }
    }

    fn merge(&mut self, other: Report) sync {
        self.requests += other.requests
        self.failures += other.failures
        for (path, counts) in other.paths {
            self.paths
                .entry(path)
                .and_modify fn { a.merge(&counts) }
                .or_insert(counts)
        }
    }
}

fn main() throws {
    let path = cli::args().nth(1) ?? "access.log"

    let data = fs::map(&path) catch {
        eprintln("cannot open {path}: {error}")
        return
    }

    // The whole parse. A malformed line is a value, not a panic: the parser
    // reports the offset it failed at in the *file*, not in whichever piece a
    // core happened to be holding (ADR-009 D3).
    let report = dsl Log from data catch {
        eprintln("{path}: {error}")
        return
    }

    println("{report.requests} requests, {report.failures} failed")

    let mut names = report.paths.keys().collect()
    names.sort()

    let body = names
        .map fn {
            let c = &report.paths[a]
            "{a} {c.hits} {c.bytes}"
        }
        .join("\n")

    println("{body}")
}
