// examples/inventory/page.nika
//
// The rendering, and nothing about parsing. It names `Entry`, which
// `stock.nika` declares - and writes it plainly, because the files of a package
// share one namespace (Part I, 9.1) and there is nothing to import.

use std::html

// The title is a Kap 5.1 option: after the `;`, named at the call, defaulted.
pub fn render(entries: Vec[Entry], total: i64; title: ref String = "Stock") -> String {
    return dsl html {
        <html>
        <head><title>{title}</title></head>
        <body>
        <h1>{title}</h1>
        <table>
        <tr><th>Category</th><th>Item</th><th>Count</th></tr>
        <for e in :entries><tr><td>{e.category}</td><td>{e.item}</td><td>{e.count}</td></tr></for>
        </table>
        <p>{total} in total</p>
        </body>
        </html>
    } eod
}
