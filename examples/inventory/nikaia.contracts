# AUTO-GENERATED by `nikaia`. Commit this file like a lockfile.
# Do not edit by hand - it is regenerated on every build.
#
# What a caller has to know about a function it cannot see the body of:
# whether it may pause (`sync`), whether it may fail and with what
# (`throws`), and what its result may point into (`returns`). Part III, 13.5.
#
# A `"?"` among the errors is the absence of a claim: it fails, with
# something this compiler cannot name.
version = 2
toolchain = "nikaia 0.1.0"
inference = "stage0-signatures+sync-bodies+throws-bodies+sharing-bodies"

[sources]
"stock.nika" = "da24bfe270d8db54ac628a9e4fe7892122da11fc7ab947c4a6abe9966fcfc08b"

[fn."Stock::file"]
pub = true
sync = true
throws = ["ParseError"]
keeps = ["input"]
touches = []
views = ["input: borrowed", "<result>: borrowed"]
signature = "(input: ?) -> Vec[Entry]"

[fn."read"]
pub = true
sync = "inferred"
throws = ["ParseError"]
keeps = ["data"]
touches = []
views = ["data: borrowed", "<result>: borrowed"]
signature = "(data: ref String) -> Vec[Entry]"

[fn."total"]
pub = true
sync = "inferred"
touches = []
views = ["entries: borrowed"]
signature = "(entries: ref Vec[Entry]) -> i64"

[fn."weight"]
sync = "inferred"
touches = []
views = ["entry: borrowed"]
signature = "(entry: ref Entry) -> i64"

[type."Entry"]
pub = true
borrowed = true
fields = ["pub category: ref String", "pub item: ref String", "pub count: i64"]
tethered = ["category", "item"]
