# AUTO-GENERATED by `nikaia`. Commit this file like a lockfile.
# Do not edit by hand - it is regenerated on every build.
#
# What a caller has to know about a function it cannot see the body of:
# whether it may pause (`sync`), whether it may fail and with what
# (`throws`), and what its result may point into (`returns`). Part III, 13.5.
#
# A `"?"` among the errors is the absence of a claim: it fails, with
# something this compiler cannot name.
version = 2
toolchain = "nikaia 0.1.0"
inference = "stage0-signatures+sync-bodies+throws-bodies+sharing-bodies"

[sources]
"rust.nika" = "3a98629ba29f7a4782db753c79fff7e77381c754837b03aec1da023056bf2f19"

[fn."Rust::file"]
pub = true
sync = true
throws = ["ParseError"]
keeps = ["input"]
locks = "?"
touches = []
views = ["input: borrowed", "<result>: borrowed"]
signature = "(input: ?) -> Vec[Item]"

[fn."joined"]
sync = "inferred"
keeps = ["pieces"]
locks = "?"
touches = []
views = ["pieces: borrowed", "<result>: borrowed"]
signature = "(pieces: Vec[Called]) -> Vec[ref String]"

[fn."kept"]
sync = "inferred"
keeps = ["found"]
locks = "?"
touches = []
views = ["found: borrowed", "<result>: borrowed"]
signature = "(found: Vec[Found]) -> Vec[Item]"

[type."Fun"]
pub = true
fields = ["pub name: ref String", "pub generics: ref String", "pub calls: Vec[ref String]", "pub wheres: ref String", "pub pauses: bool", "pub parts: Vec[Part]", "pub result: ref String"]
tethered = ["name", "generics", "calls", "wheres", "parts", "result"]

[type."Group"]
pub = true
fields = ["pub what: ref String", "pub name: ref String", "pub via: ref String", "pub visible: bool", "pub items: Vec[Item]"]
tethered = ["what", "name", "via", "items"]

[type."Part"]
pub = true
fields = ["pub name: ref String", "pub ty: ref String"]
tethered = ["name", "ty"]

[type."Rec"]
pub = true
fields = ["pub what: ref String", "pub name: ref String", "pub parts: Vec[Part]"]
tethered = ["what", "name", "parts"]
